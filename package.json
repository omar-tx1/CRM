{
  "name": "tjb-crm-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/types",
    "packages/ui",
    "packages/config"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "npm run format --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  "name": "tjb-crm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -w apps/api build && npm run -w apps/web build",
    "dev": "concurrently -r \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run -w apps/api dev",
    "dev:web": "npm run -w apps/web dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "seed": "npm run -w apps/api seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
